# 运营平台 — 生产和本地共用环境变量
# H5 模式 API 走完整 HTTPS URL（Nginx 反代统一协议，避免混合内容问题）
# 小程序模式 API 走完整 HTTPS URL（微信强制 HTTPS）

# 运营平台入口地址（API 请求的基础 URL）
# 本地: http://localhost:3035
# 远程: https://boss.jdzn99.com（Docker 部署，Nginx 代理 /api/ops/ → ops backend）
VITE_OPS_ENTRY=https://boss.jdzn99.com

# 默认组织 ID
VITE_CORP_ID=4
